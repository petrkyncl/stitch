# Either the OpenAI API (OPENAI_API_KEY) or any OpenAI-compatible endpoint, e.g. a local Claude wrapper:
# LLM_BASE_URL=http://localhost:3456/v1
# LLM_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING=low
# USD per 1M tokens, used for the cost meter
PRICE_IN=0.25
PRICE_OUT=2
ADB=/Users/Petr/Tools/platform-tools/adb
ANDROID_SERIAL=
PORT=4400

# A stronger model for exploring apps while learning (once per capability; reuse costs nothing)
LLM_EXPLORE_MODEL=claude-sonnet-5-5
EXPLORE_PRICE_IN=2
EXPLORE_PRICE_OUT=10
